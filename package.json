{
  "name": "megalodon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "MEGALODON_PORT=4610 MEGALODON_WEB_PORT=5610 MEGALODON_DATA_DIR=~/.megalodon-dev pnpm -r --parallel dev",
    "build": "pnpm --filter @megalodon/web build",
    "start": "pnpm build && MEGALODON_SERVE_WEB=1 pnpm --filter @megalodon/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
